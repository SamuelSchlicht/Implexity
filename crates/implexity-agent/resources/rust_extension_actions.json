    {
      "name": "export_animation",
      "label": "Export animation",
      "permission": "read",
      "mutates": false,
      "requires_model": false,
      "description": "Export stored dynamic frames as WebP, GIF, MP4, or PNG ZIP. Read the returned file hash. Use max_bytes within its declared limit.",
      "input_schema": {
        "type": "object",
        "properties": {
          "store": {
            "type": "string",
            "minLength": 9,
            "maxLength": 120,
            "pattern": "^(service/[A-Za-z0-9_-][A-Za-z0-9_.-]{0,95}|job/[0-9a-f]{12}/[A-Za-z0-9_-][A-Za-z0-9_.-]{0,95})$",
            "description": "a dynamic result store: service/<store> or job/<job_id>/<store> (from inspect_dynamic_results)"
          },
          "cycle": {
            "oneOf": [
              {
                "const": "last"
              },
              {
                "type": "integer",
                "minimum": -1000000000,
                "maximum": 1000000000
              }
            ],
            "description": "which retained cycle (default last); transient stores ignore it"
          },
          "cycles": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "frames_per_cycle": {
            "type": "integer",
            "minimum": 2,
            "maximum": 96
